# Settings for the virtual drone. Copy this file to .env and adjust it:
#   cp .env.example .env
# .env is not stored in git, because these settings differ per computer.

# Address of the ground station.
# host.docker.internal = the computer the containers run on (here: the Mac).
# When the drone runs on another device (e.g. a Raspberry Pi), use the ground station's IP address.
GROUND_HOST=host.docker.internal

# MediaMTX stream path for this drone. Must match STREAM_KEY in edge/ground-station/.env.
STREAM_KEY=d7f3a91c

# Folder on this computer that contains the video. Write the full path (no ~).
VIDEO_DIR=/Users/andreas/wildfire-prediction-uav/media/videos

# Video to play, inside VIDEO_DIR.
VIDEO_FILE=zenmuse.mp4

# Video bitrate. Typical drone video links carry 2-8 Mbit/s.
BITRATE=4M

# Drone start position: latitude, longitude, altitude (m), heading (degrees).
HOME_LOCATION=55.7670,12.3830,40,0
