{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/logs/*.log",
            "log_group_name": "/drone-surveillance-system/ground-station/logs",
            "log_stream_name": "{hostname}",
            "timestamp_format": "%Y-%m-%dT%H:%M:%S%z",
            "retention_in_days": 30
          }
        ]
      }
    }
  }
}